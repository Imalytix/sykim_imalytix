{
  "manifest_version": 3,
  "name": "imalytix",
  "version": "0.3.0",
  "description": "웹페이지의 이미지를 우클릭해 AI 생성 여부를 바로 분석합니다. (개발 버전 — 로컬 서버 전용)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Imalytix 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
}
