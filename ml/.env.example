# Copy this file to ml/.env and fill in the values you need.

# --- download_real_images.py (legacy, non-training use only — see its docstring) ---
# Get a free key at https://unsplash.com/developers (New Application -> Access Key)
UNSPLASH_ACCESS_KEY=

# --- backbone.py: which vision backbone to embed images with ---
# Leave everything below unset to use the default: DINOv2-small via Hugging Face.
#
# To use a DINOv3 checkpoint instead (see ml/DINOV3_SETUP.md for the full guide):
# IMALYTIX_BACKBONE_SOURCE=torchhub
# IMALYTIX_BACKBONE=dinov3_vits16
# IMALYTIX_BACKBONE_WEIGHTS=./checkpoints/dinov3_vits16_pretrain_lvd1689m-08c60483.pth
