# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# Claude Code local runtime state (scheduling locks etc.) — not project config
/.claude/

# personal scratch notebooks — not part of the app
/Imalytix_Implementation_Review_v2.ipynb

# typescript
*.tsbuildinfo
next-env.d.ts

# local storage: analyzed images + request logs (never commit user-uploaded content)
/storage/

# generated performance test images/reports (regenerate via scripts/generate-test-dataset.js)
/test-data/images/
/test-data/report*.json

# accuracy-measurement dataset (scripts/measure-accuracy.js) — real team-member photos and
# AI-generated/forged test images, never commit (personal photos + repo bloat)
/test-data/accuracy-dataset/*
!/test-data/accuracy-dataset/README.md
/test-data/accuracy-report.json
/test-data/accuracy-report.md
